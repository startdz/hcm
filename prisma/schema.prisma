generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(150)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  departments Department[]

  @@map("companies")
}

model Department {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String  @db.VarChar(150)
  company_id String  @db.Uuid
  company    Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  employees Employee[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@unique([company_id, name])
  @@index([company_id])
  @@map("departments")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String    @unique @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  password_hash String    @db.VarChar(255)
  is_active     Boolean   @default(true)
  last_login_at DateTime? @db.Timestamptz(6)

  employee      Employee?
  roles         UserRole[]
  user_sessions Session[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("users")
}

model Session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // SIMPAN HASH TOKEN, BUKAN MENTAH. DEFAULT BERTAHAN 7D
  refresh_token_hash String @unique @db.VarChar(255)

  ip         String? @db.VarChar(45)
  user_agent String? @db.VarChar(500)

  expires_at   DateTime  @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model Employee {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emp_number String         @unique @db.VarChar(35)
  first_name String         @db.VarChar(100)
  last_name  String?        @db.VarChar(100)
  status     EmployeeStatus @default(ACTIVE)

  department_id String?     @db.Uuid
  department    Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)

  user_id String? @unique @db.Uuid
  user    User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  profile            EmployeeProfile?
  employee_addresses EmployeeAddress[]
  emergency_contacts EmployeeEmergencyContact[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([department_id])
  @@index([status])
  @@map("employees")
}

model EmployeeProfile {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_image  String?                @db.VarChar(255)
  place_of_birth String?                @db.VarChar(150)
  date_of_birth  DateTime?              @db.Date
  phone_number   String?                @db.VarChar(30)
  gender         EmployeeGender?
  marital_status EmployeeMaritalStatus?

  employee_id String   @unique @db.Uuid
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("employee_profiles")
}

model EmployeeAddress {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country      String  @db.VarChar(100)
  city         String  @db.VarChar(100)
  district     String  @db.VarChar(100)
  subdistrict  String  @db.VarChar(100)
  zipcode      String  @db.VarChar(20)
  street       String  @db.VarChar(150)
  full_address String  @db.VarChar(255)
  label        String  @db.VarChar(100)
  is_primary   Boolean @default(false)

  employee_id String   @db.Uuid
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([employee_id])
  @@map("employee_addresses")
}

model EmployeeEmergencyContact {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String  @db.VarChar(100)
  phone_number        String  @db.VarChar(30)
  relationship_status String  @db.VarChar(50)
  address             String? @db.VarChar(255)

  employee_id String   @db.Uuid
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([employee_id])
  @@map("employee_emergency_contacts")
}

// RBAC: role dapat diberikan kepada banyak user.
model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)
  is_system   Boolean @default(false)
  is_active   Boolean @default(true)

  users       UserRole[]
  permissions RolePermission[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("roles")
}

// Contoh code permission: employees.read, employees.create, leaves.approve.
model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)
  module      String  @db.VarChar(50)

  roles RolePermission[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([module])
  @@map("permissions")
}

model UserRole {
  user_id     String   @db.Uuid
  role_id     String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([role_id])
  @@map("user_roles")
}

model RolePermission {
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  granted_at    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

// Master jenis cuti, bukan pengajuan cuti.
model Leave {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String  @unique @db.VarChar(30)
  name              String  @db.VarChar(100)
  description       String? @db.VarChar(255)
  default_days      Int?
  is_paid           Boolean @default(true)
  requires_approval Boolean @default(true)
  is_active         Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("leaves")
}

enum EmployeeMaritalStatus {
  SINGLE
  MARRIED
  SEPARATED
  DIVORCED
  WIDOWED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  MUTATED
}

enum EmployeeGender {
  MALE
  FEMALE
}
